# Required
OPENAI_API_KEY=your_openai_api_key_here

# Optional — override if Phoenix is running somewhere other than localhost
# When using Docker Compose this is set automatically to http://phoenix:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Optional — Phoenix project name (defaults to "travel-assistant" in code)
# PHOENIX_PROJECT_NAME=travel-assistant
